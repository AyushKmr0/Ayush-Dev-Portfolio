{
  "name": "ayush-portfolio",
  "version": "1.0.0",
  "private": true,
  "description": "Ayush's full-stack portfolio website",
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "dev": "npm run dev --workspaces --if-present --parallel",
    "dev:client": "npm run dev --workspace=client",
    "dev:server": "npm run dev --workspace=server",
    "build": "npm run build --workspaces --if-present",
    "start": "npm run start --workspace=server",
    "test": "npm run test:run --workspace=client",
    "lint": "npm run lint --workspace=client"
  },
  "engines": {
    "node": ">=24.12.0 <25"
  }
}
